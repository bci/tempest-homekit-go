#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook:
# - Format staged Go files with gofmt (and restage them)
# - If JS files are staged, run `npm test` (silent) and fail commit if tests fail
#
# Git runs this hook from the repository root before every commit once hooks
# are enabled with `git config core.hooksPath .githooks` (see AGENTS.md).
#
# Usage: invoked by git; no arguments. Bypass once with `git commit --no-verify`.
#
# Only added, copied and modified files are considered (--diff-filter=ACM), so
# deletions and renames never trigger formatting or tests. Each staged .go file
# is rewritten in place with `gofmt -s -w` and then re-added with `git add`;
# because the whole file is re-added, any unstaged hunks in that file are
# staged too. With `set -euo pipefail`, a non-zero `npm test` aborts the hook
# and therefore the commit. If npm is not on PATH the JS tests are skipped with
# a message rather than failing. Exits 0 when every check passes.

echo "Running pre-commit checks..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if echo "$STAGED_FILES" | grep -E '\.go$' >/dev/null; then
  echo "Formatting Go files..."
  echo "$STAGED_FILES" | grep -E '\.go$' | while read -r file; do
    if [ -f "$file" ]; then
      gofmt -s -w "$file"
      git add "$file"
    fi
  done
fi

if echo "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx)$' >/dev/null; then
  if command -v npm >/dev/null; then
    echo "Running JS tests for staged changes..."
    npm test --silent
  else
    echo "npm not found; skipping JS tests"
  fi
fi

echo "Pre-commit checks passed."

exit 0
